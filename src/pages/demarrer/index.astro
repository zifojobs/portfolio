---
// Questionnaire de démarrage (22/11/2026). Spec : docs/superpowers/specs/2026-11-21-questionnaire-demarrage-design.md
// Le jeton d'un lien personnalisé passe dans le fragment (#t=…) : il n'atteint jamais Vercel.
import LayoutDemarrer from "../../layouts/LayoutDemarrer.astro";
---

<LayoutDemarrer>
	<main class="dm" id="app">
		<header class="dm-tete">
			<img src="/demarrer/saibo.jpg" alt="" width="44" height="44" class="dm-ava" />
			<div class="dm-qui">
				<b>Saïbo Danfakha</b>
				<span id="sous">Développeur web</span>
			</div>
		</header>
		<div class="dm-barre" id="barre" hidden><i id="barre-i"></i></div>

		<section id="ecran" class="dm-ecran" aria-live="polite">
			<p class="dm-chargement">Un instant…</p>
		</section>

		<aside id="carte" class="dm-carte vide" aria-label="Votre projet">
			<img id="carte-logo" class="dm-carte-logo" alt="" hidden />
			<span class="dm-carte-lbl">Votre projet</span>
			<b id="carte-nom" class="dm-carte-nom"></b>
			<div id="carte-tags" class="dm-carte-tags"></div>
			<span id="carte-vide" class="dm-carte-vide">se dessine au fil de vos réponses…</span>
		</aside>

		<section id="dossier" class="dm-dossier" hidden></section>
		<canvas id="toile" width="1080" height="1920" hidden></canvas>
	</main>

	<noscript><p style="padding:24px">Ce questionnaire a besoin de JavaScript. Vous pouvez aussi m'écrire sur WhatsApp : +221 77 527 71 64.</p></noscript>

	<script>
		import "../../scripts/demarrer.ts";
	</script>
</LayoutDemarrer>

<style is:global>
	.dm {
		max-width: 480px;
		margin: 0 auto;
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
		padding: max(16px, env(safe-area-inset-top)) 16px max(16px, env(safe-area-inset-bottom));
	}
	.dm-tete {
		display: flex;
		align-items: center;
		gap: 12px;
		padding-top: 8px;
	}
	.dm-ava {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		object-fit: cover;
		flex: none;
	}
	.dm-qui {
		font-size: 14px;
		line-height: 1.25;
		color: var(--gris);
	}
	.dm-qui b {
		display: block;
		font-size: 15px;
		color: var(--encre);
		font-weight: 700;
	}
	.dm-barre {
		height: 4px;
		background: #e4ded4;
		border-radius: 4px;
		margin-top: 14px;
		overflow: hidden;
	}
	.dm-barre i {
		display: block;
		height: 100%;
		width: 0;
		background: var(--encre);
		border-radius: 4px;
		transition: width 0.35s ease;
	}
	.dm-ecran {
		flex: 1;
		padding: 28px 0 24px;
	}
	.dm-ecran h1 {
		font-size: clamp(26px, 7vw, 32px);
		line-height: 1.12;
		font-weight: 800;
		letter-spacing: -0.025em;
		margin: 0 0 16px;
	}
	.dm-ecran h1:focus {
		outline: none;
	}
	.dm-intro {
		font-size: 17px;
		color: var(--gris);
		margin: 0 0 24px;
	}
	.dm-pourquoi {
		background: var(--blanc);
		border-radius: 14px;
		padding: 12px 14px;
		font-size: 15px;
		color: #444;
		margin: 0 0 20px;
	}
	.dm-pourquoi b {
		color: var(--encre);
	}
	.dm-champ {
		margin: 0 0 18px;
		border: 0;
		padding: 0;
	}
	.dm-champ legend,
	.dm-champ label.dm-lbl {
		display: block;
		font-weight: 600;
		font-size: 15px;
		margin: 0 0 8px;
		padding: 0;
	}
	.dm-texte {
		width: 100%;
		min-height: 52px;
		border: 1.5px solid var(--encre);
		border-radius: 12px;
		padding: 12px 14px;
		font-size: 17px;
		background: var(--blanc);
	}
	.dm-puces {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.dm-puce {
		min-height: 44px;
		padding: 10px 14px;
		border-radius: 999px;
		border: 1.5px solid var(--bord);
		background: var(--blanc);
		font-size: 15px;
		cursor: pointer;
		text-align: left;
	}
	.dm-puce[aria-pressed="true"] {
		background: var(--encre);
		color: var(--blanc);
		border-color: var(--encre);
	}
	.dm-pastille {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 3px solid var(--blanc);
		box-shadow: 0 0 0 1.5px var(--bord);
		cursor: pointer;
	}
	.dm-pastille[aria-pressed="true"] {
		box-shadow: 0 0 0 3px var(--encre);
	}
	.dm-pastille-libre {
		position: relative;
		display: inline-block;
		background: conic-gradient(#e63946, #f39221, #e9c46a, #2a9d8f, #1d3557, #7a1f2b, #e63946);
		overflow: hidden;
	}
	.dm-couleur-libre {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		cursor: pointer;
		border: 0;
		padding: 0;
	}
	.dm-aide {
		font-size: 14px;
		color: var(--gris);
		margin: 8px 0 0;
	}
	.dm-logo-apercu {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-top: 10px;
	}
	.dm-logo-apercu img {
		width: 56px;
		height: 56px;
		object-fit: contain;
		background: var(--blanc);
		border-radius: 10px;
		border: 1px solid var(--bord);
	}
	.dm-actions {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-top: 8px;
	}
	.dm-btn {
		min-height: 52px;
		padding: 14px 22px;
		border: 0;
		border-radius: 12px;
		background: var(--encre);
		color: var(--blanc);
		font-weight: 600;
		font-size: 16px;
		cursor: pointer;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
	}
	.dm-btn[disabled] {
		opacity: 0.35;
		cursor: not-allowed;
	}
	.dm-btn.large {
		width: 100%;
	}
	.dm-lien {
		background: none;
		border: 0;
		padding: 8px 0;
		color: var(--gris);
		text-decoration: underline;
		text-underline-offset: 3px;
		font-size: 15px;
		cursor: pointer;
	}
	.dm-erreur {
		background: #fdecea;
		color: #7a1f1f;
		border-radius: 12px;
		padding: 12px 14px;
		margin: 16px 0 0;
		font-size: 15px;
	}
	.dm-chargement {
		color: var(--gris);
	}
	.dm-carte {
		position: sticky;
		bottom: max(12px, env(safe-area-inset-bottom));
		border-radius: 18px;
		padding: 14px 16px;
		background: var(--client);
		color: var(--client-texte);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
		view-transition-name: carte;
		transition: background-color 0.4s ease;
	}
	.dm-carte.vide {
		background: var(--blanc);
		color: #8a8a8a;
		border: 1.5px dashed var(--bord);
		box-shadow: none;
	}
	.dm-carte-lbl {
		display: block;
		font-size: 13px;
		opacity: 0.75;
	}
	.dm-carte-nom {
		display: block;
		font-weight: 800;
		font-size: 18px;
		margin: 2px 0 8px;
		letter-spacing: 0.01em;
		overflow-wrap: anywhere;
		padding-right: 52px;
	}
	.dm-carte-nom:empty {
		display: none;
	}
	.dm-carte-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.dm-carte-tags span {
		font-size: 13px;
		padding: 3px 9px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--client-texte) 16%, transparent);
	}
	.dm-carte-tags span.nouveau {
		background: var(--accent);
		color: var(--accent-texte);
		font-weight: 600;
		animation: dm-pop 0.4s ease;
	}
	@keyframes dm-pop {
		from {
			transform: scale(0.8);
			opacity: 0;
		}
	}
	.dm-carte:not(.vide) .dm-carte-vide {
		display: none;
	}
	.dm-carte-vide {
		display: block;
		font-size: 14px;
		margin-top: 2px;
	}
	.dm-carte-logo {
		float: right;
		width: 44px;
		height: 44px;
		object-fit: contain;
		background: var(--blanc);
		border-radius: 10px;
		padding: 4px;
	}
	.dm-dossier {
		background: var(--client);
		color: var(--client-texte);
		border-radius: 24px;
		padding: 28px 22px;
		margin: 24px 0 8px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		view-transition-name: carte;
	}
	.dm-dossier .dm-carte-logo {
		float: none;
		align-self: flex-end;
		width: 56px;
		height: 56px;
	}
	.dm-dossier .k {
		font-size: 14px;
		opacity: 0.8;
	}
	.dm-dossier h1 {
		font-size: clamp(28px, 8vw, 34px);
		line-height: 1.08;
		font-weight: 800;
		letter-spacing: -0.025em;
		margin: 0;
	}
	.dm-dossier .boite {
		background: color-mix(in srgb, var(--client-texte) 10%, transparent);
		border-radius: 14px;
		padding: 12px 14px;
		font-size: 15px;
	}
	.dm-dossier .boite b {
		display: block;
		margin-bottom: 4px;
	}
	.dm-dossier dl {
		margin: 0;
	}
	.dm-dossier dt {
		font-size: 13px;
		opacity: 0.75;
		margin-top: 8px;
	}
	.dm-dossier dd {
		margin: 0;
	}
	.dm-chemin {
		display: flex;
		gap: 4px;
		margin: 6px 0 8px;
	}
	.dm-chemin i {
		flex: 1;
		height: 6px;
		border-radius: 3px;
		background: color-mix(in srgb, var(--client-texte) 25%, transparent);
	}
	.dm-chemin i:first-child {
		background: var(--accent);
	}
	.dm-promesse {
		background: var(--accent);
		color: var(--accent-texte);
		border-radius: 14px;
		padding: 12px 14px;
		font-weight: 600;
	}
	.dm-apres {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin: 8px 0 24px;
	}
	.dm-btn.secondaire {
		background: var(--blanc);
		color: var(--encre);
		border: 1.5px solid var(--encre);
	}
	.dm-merci {
		font-size: 15px;
		color: var(--gris);
		margin: 0;
	}
</style>
